# The only place that selects which TDLib source is built.
# Official TDLib release 1.8.56 (tdlib/td CMakeLists.txt: project(TDLib VERSION 1.8.56)).
TDLIB_VERSION=1.8.56
TDLIB_COMMIT=dd1b761fda7e47f4e0275c4d319f80a04db1997f
# Source patches applied on top of TDLIB_COMMIT (BSL-1.0, see NOTICE). The build applies them with
# `git apply --index` and commits with the fixed identity, date and message below, so the resulting commit - the
# value TDLib reports as option "commit_hash" - is reproducible and must equal TDLIB_PATCHED_COMMIT.
TDLIB_PATCHES=patches/0001-parallel-file-hashes.patch
TDLIB_PATCH_NAME=tdlib-android
TDLIB_PATCH_EMAIL=tdlib-android@users.noreply.github.com
TDLIB_PATCH_DATE=2026-10-13T00:00:00Z
TDLIB_PATCH_MESSAGE=tdlib-android-patches-BSL-1.0
TDLIB_PATCHED_COMMIT=5a820775f6131520457949251510d2b932b30345
# Release tag and artifact base name.
RELEASE_TAG=v1.8.56-dd1b761f-p1
ARTIFACT_NAME=tdlib-android
