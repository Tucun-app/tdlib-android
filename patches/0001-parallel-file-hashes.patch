   bool stop_flag_ = false;
diff --git a/td/telegram/files/FileHashWindow.h b/td/telegram/files/FileHashWindow.h
new file mode 100644
index 0000000..68e746c
--- /dev/null
+++ b/td/telegram/files/FileHashWindow.h
@@ -0,0 +1,197 @@
+//
+// Parallel upload.getFileHashes for FileDownloader's only-check mode (option "x_file_hashes_inflight").
+// Added by Tucun-app/tdlib-android patches/0001-parallel-file-hashes.patch; distributed under the
+// Boost Software License, Version 1.0 (same as TDLib; see LICENSE_1_0.txt or http://www.boost.org/LICENSE_1_0.txt).
+//
+// Pure logic only: which offsets to ask next and how many queries are in flight. It does not compare anything;
+// FileDownloader::check_loop keeps the only comparison code (local sha256 vs. server hash) unchanged.
+// Depends on the standard library only, so it can be unit-tested on its own (tests/hash_window_test.cpp).
+//
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <utility>
+#include <vector>
+
+namespace td {
+namespace file_hash_window {
+
+// Every upload.getFileHashes answer covers 8 x 128 KiB = 1 MiB.
+constexpr int64_t kHashStride = int64_t{1} << 20;
+constexpr int32_t kMaxInflightLimit = 32;
+
+inline int32_t clamp_limit(int64_t requested) {
+  if (requested < 1) {
+    return 1;
+  }
+  if (requested > kMaxInflightLimit) {
+    return kMaxInflightLimit;
+  }
+  return static_cast<int32_t>(requested);
+}
+
+// Number of only-check getFileHashes queries in flight in the whole process (only files with limit > 1 count).
+class Counter {
+ public:
+  // The first query of a file that has nothing in flight is never blocked (no starvation).
+  void acquire_base() {
+    value_.fetch_add(1);
+  }
+
+  // Any further query of a file needs value < limit.
+  bool try_acquire_extra(int32_t limit) {
+    int32_t current = value_.load();
+    while (current < limit) {
+      if (value_.compare_exchange_weak(current, current + 1)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Returns false (and keeps 0) if there was nothing to release.
+  bool release() {
+    int32_t current = value_.load();
+    while (current > 0) {
+      if (value_.compare_exchange_weak(current, current - 1)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  int32_t value() const {
+    return value_.load();
+  }
+
+ private:
+  std::atomic<int32_t> value_{0};
+};
+
+// One instance per process (a function-local static of an inline function is shared by all translation units).
+inline Counter &global_counter() {
+  static Counter counter;
+  return counter;
+}
+
+// The in-flight queries of one file: token -> (offset, payload). Each token releases the counter at most once.
+template <class Payload>
+class InflightTable {
+ public:
+  bool empty() const {
+    return queries_.empty();
+  }
+
+  size_t size() const {
+    return queries_.size();
+  }
+
+  void add(uint64_t token, int64_t offset, Payload payload) {
+    queries_.emplace(token, std::make_pair(offset, std::move(payload)));
+  }
+
+  // Removes the query and releases one counter slot. Returns false for an unknown (or already removed) token.
+  bool take(uint64_t token, Counter &counter, Payload *payload) {
+    auto it = queries_.find(token);
+    if (it == queries_.end()) {
+      return false;
+    }
+    *payload = std::move(it->second.second);
+    queries_.erase(it);
+    counter.release();
+    return true;
+  }
+
+  // Removes every query (tear down); `on_payload` is called for each one before its slot is released.
+  template <class F>
+  void drain(Counter &counter, F &&on_payload) {
+    for (auto &query : queries_) {
+      on_payload(query.second.second);
+      counter.release();
+    }
+    queries_.clear();
+  }
+
+  std::vector<int64_t> offsets() const {
+    std::vector<int64_t> result;
+    for (auto &query : queries_) {
+      result.push_back(query.second.first);
+    }
+    return result;
+  }
+
+  std::vector<uint64_t> tokens() const {
+    std::vector<uint64_t> result;
+    for (auto &query : queries_) {
+      result.push_back(query.first);
+    }
+    return result;
+  }
+
+ private:
+  std::map<uint64_t, std::pair<int64_t, Payload>> queries_;
+};
+
+// Offsets of the next getFileHashes queries of one file, called when the checked prefix can't advance.
+//   checked_prefix   - first byte not yet verified (not covered by any known hash);
+//   covered_end      - largest end of any known hash;
+//   inflight_offsets - offsets of this file's queries in flight.
+// A counter slot is acquired for every returned offset: the first one unconditionally if the file has nothing in
+// flight, every other one only while counter < limit. Order: the gap at the checked prefix first (unless an
+// in-flight query starting in (checked_prefix - stride, checked_prefix] will cover it), then forward with a
+// fixed 1 MiB stride from the end of everything known or in flight, never at or past the end of the file.
+inline std::vector<int64_t> pick_offsets(int64_t checked_prefix, int64_t file_size, int64_t covered_end,
+                                         const std::vector<int64_t> &inflight_offsets, int32_t limit,
+                                         Counter &counter) {
+  std::vector<int64_t> result;
+  if (file_size <= 0 || checked_prefix < 0 || checked_prefix >= file_size) {
+    return result;
+  }
+  if (limit < 1) {
+    limit = 1;
+  }
+  size_t file_inflight = inflight_offsets.size();
+  auto take_slot = [&]() {
+    if (file_inflight == 0) {
+      counter.acquire_base();
+    } else if (!counter.try_acquire_extra(limit)) {
+      return false;
+    }
+    file_inflight++;
+    return true;
+  };
+
+  int64_t next = checked_prefix > covered_end ? checked_prefix : covered_end;
+  bool prefix_pending = false;
+  for (auto offset : inflight_offsets) {
+    if (offset > checked_prefix - kHashStride && offset <= checked_prefix) {
+      prefix_pending = true;
+    }
+    if (offset + kHashStride > next) {
+      next = offset + kHashStride;
+    }
+  }
+  if (!prefix_pending) {
+    if (!take_slot()) {
+      return result;
+    }
+    result.push_back(checked_prefix);
+    if (checked_prefix + kHashStride > next) {
+      next = checked_prefix + kHashStride;
+    }
+  }
+  while (next < file_size && static_cast<int32_t>(result.size()) < limit) {
+    if (!take_slot()) {
+      break;
+    }
+    result.push_back(next);
+    next += kHashStride;
+  }
+  return result;
+}
+
+}  // namespace file_hash_window
+}  // namespace td
