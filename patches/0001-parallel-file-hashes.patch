From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tdlib-android <tdlib-android@users.noreply.github.com>
Date: Tue, 13 Oct 2026 00:00:00 +0000
Subject: [PATCH] Parallel upload.getFileHashes in only-check mode (option
 x_file_hashes_inflight)

Modification of TDLib (https://github.com/tdlib/td) by Tucun-app/tdlib-android,
released under the Boost Software License, Version 1.0 (same as TDLib; see
LICENSE_1_0.txt). Files changed: td/telegram/files/FileDownloader.h,
td/telegram/files/FileDownloader.cpp; new: td/telegram/files/FileHashWindow.h.

When a file is downloaded in only-check mode (TDLib found a local file with the
same name and size and verifies it against the server hashes instead of
downloading it), up to x_file_hashes_inflight upload.getFileHashes queries of
the file may be in flight at once (default 1 = unmodified behaviour; clamped to
1..32). A process-wide counter limits the extra queries. The comparison of local
bytes with the server hashes in FileDownloader::check_loop is unchanged and is
still the only code that advances the checked prefix.
---
 td/telegram/files/FileDownloader.cpp |  84 ++++++++++--
 td/telegram/files/FileDownloader.h   |   7 +
 td/telegram/files/FileHashWindow.h   | 197 +++++++++++++++++++++++++++
 3 files changed, 277 insertions(+), 11 deletions(-)
 create mode 100644 td/telegram/files/FileHashWindow.h

diff --git a/td/telegram/files/FileDownloader.cpp b/td/telegram/files/FileDownloader.cpp
index 5ccf9e9..99a528d 100644
--- a/td/telegram/files/FileDownloader.cpp
+++ b/td/telegram/files/FileDownloader.cpp
@@ -371,25 +371,61 @@ Status FileDownloader::check_loop(int64 checked_prefix_size, int64 ready_prefix_
       is_changed = true;
       continue;
     }
-    if (!has_hash_query_) {
-      has_hash_query_ = true;
-      auto query = telegram_api::upload_getFileHashes(remote_.as_input_file_location(), checked_prefix_size);
-      auto net_query_type = is_small_ ? NetQuery::Type::DownloadSmall : NetQuery::Type::Download;
-      auto net_query = G()->net_query_creator().create(query, {}, remote_.get_dc_id(), net_query_type);
-      queries.push_back(std::move(net_query));
+    // x_file_hashes_inflight: begin R1
+    if (hash_inflight_limit_ <= 1) {
+      if (!has_hash_query_) {
+        has_hash_query_ = true;
+        auto query = telegram_api::upload_getFileHashes(remote_.as_input_file_location(), checked_prefix_size);
+        auto net_query_type = is_small_ ? NetQuery::Type::DownloadSmall : NetQuery::Type::Download;
+        auto net_query = G()->net_query_creator().create(query, {}, remote_.get_dc_id(), net_query_type);
+        queries.push_back(std::move(net_query));
+        break;
+      }
+      // Should fail?
+      break;
+    } else {
+      // Only asks for hashes; the comparison above stays the only code that advances the checked prefix.
+      if (!hash_no_new_queries_) {
+        int64 covered_end = 0;
+        if (!hash_info_.empty()) {
+          covered_end = hash_info_.rbegin()->offset + narrow_cast<int64>(hash_info_.rbegin()->size);
+        }
+        auto offsets = file_hash_window::pick_offsets(checked_prefix_size, size_, covered_end, hash_queries_.offsets(),
+                                                      hash_inflight_limit_, file_hash_window::global_counter());
+        for (auto offset : offsets) {
+          auto query = telegram_api::upload_getFileHashes(remote_.as_input_file_location(), offset);
+          auto net_query_type = is_small_ ? NetQuery::Type::DownloadSmall : NetQuery::Type::Download;
+          auto net_query = G()->net_query_creator().create(query, {}, remote_.get_dc_id(), net_query_type);
+          auto token = UniqueId::next(UniqueId::Type::Default, COMMON_QUERY_KEY);
+          hash_queries_.add(token, offset, net_query->cancel_slot_.get_signal_new());
+          hash_new_tokens_.push_back(token);
+          queries.push_back(std::move(net_query));
+          VLOG(file_loader) << "File hash window: ask " << offset << " prefix " << checked_prefix_size << " file \""
+                            << name_ << "\" in flight " << hash_queries_.size() << " process "
+                            << file_hash_window::global_counter().value();
+        }
+      }
       break;
     }
-    // Should fail?
-    break;
+    // x_file_hashes_inflight: end R1
   }
 
   if (is_changed) {
     on_progress();
   }
-  for (auto &query : queries) {
-    G()->net_query_dispatcher().dispatch_with_callback(
-        std::move(query), actor_shared(this, UniqueId::next(UniqueId::Type::Default, COMMON_QUERY_KEY)));
+  // x_file_hashes_inflight: begin R2
+  if (hash_inflight_limit_ <= 1) {
+    for (auto &query : queries) {
+      G()->net_query_dispatcher().dispatch_with_callback(
+          std::move(query), actor_shared(this, UniqueId::next(UniqueId::Type::Default, COMMON_QUERY_KEY)));
+    }
+  } else {
+    for (size_t i = 0; i < queries.size() && i < hash_new_tokens_.size(); i++) {
+      G()->net_query_dispatcher().dispatch_with_callback(std::move(queries[i]), actor_shared(this, hash_new_tokens_[i]));
+    }
+    hash_new_tokens_.clear();
   }
+  // x_file_hashes_inflight: end R2
   if (need_check_) {
     parts_manager_.set_need_check();
     parts_manager_.set_checked_prefix_size(checked_prefix_size);
@@ -442,6 +478,9 @@ void FileDownloader::update_resources(const ResourceState &other) {
 }
 
 void FileDownloader::hangup() {
+  if (hash_inflight_limit_ > 1) {
+    hash_no_new_queries_ = true;
+  }
   if (delay_dispatcher_.empty()) {
     stop();
   } else {
@@ -524,6 +563,13 @@ void FileDownloader::start_up() {
     }
   }
   try_release_fd();
+  if (only_check_) {
+    hash_inflight_limit_ = file_hash_window::clamp_limit(G()->get_option_integer("x_file_hashes_inflight", 1));
+    if (hash_inflight_limit_ > 1) {
+      VLOG(file_loader) << "File hash window: limit " << hash_inflight_limit_ << " file \"" << name_ << "\" process "
+                        << file_hash_window::global_counter().value();
+    }
+  }
 
   auto ready_parts = bitmask.as_vector();
   auto status = parts_manager_.init(size_, size_, true, part_size, ready_parts, false, false);
@@ -631,6 +677,12 @@ Status FileDownloader::do_loop() {
 }
 
 void FileDownloader::tear_down() {
+  if (hash_inflight_limit_ > 1) {
+    auto cancelled = hash_queries_.size();
+    hash_queries_.drain(file_hash_window::global_counter(), [](ActorShared<> &cancel) { cancel.reset(); });
+    VLOG(file_loader) << "File hash window: tear down file \"" << name_ << "\" cancelled " << cancelled << " process "
+                      << file_hash_window::global_counter().value();
+  }
   for (auto &it : part_map_) {
     it.second.second.reset();  // cancel_query(it.second.second);
   }
@@ -655,6 +707,16 @@ void FileDownloader::update_estimated_limit() {
 }
 
 void FileDownloader::on_result(NetQueryPtr query) {
+  if (hash_inflight_limit_ > 1) {
+    ActorShared<> hash_query_cancel;
+    if (hash_queries_.take(get_link_token(), file_hash_window::global_counter(), &hash_query_cancel)) {
+      hash_query_cancel.release();
+      VLOG(file_loader) << "File hash window: answer file \"" << name_ << "\" in flight " << hash_queries_.size()
+                        << " process " << file_hash_window::global_counter().value();
+    } else if (UniqueId::extract_key(get_link_token()) == COMMON_QUERY_KEY) {
+      LOG(WARNING) << "Receive result for an unknown file hash query";
+    }
+  }
   if (stop_flag_) {
     return;
   }
